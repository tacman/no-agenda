{
    "controllers": {
        "@survos/imgproxy-bundle": {
            "imgproxy": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/search-bundle": {
            "ux-search": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@survos/search-bundle/styles/ux-search.css": true
                }
            },
            "ux-search--refinement-list": {
                "enabled": true,
                "fetch": "eager"
            },
            "ux-search-range-slider": {
                "enabled": true,
                "fetch": "eager"
            },
            "instantsearch": {
                "enabled": false,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-live-component": {
            "live": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-live-component/dist/live.min.css": true
                }
            }
        }
    },
    "entrypoints": []
}
