{
    "name": "no-agenda",
    "description": "Dokku app for no-agenda",
    "keywords": [
        "php",
        "symfony"
    ],
    "repository": "https://github.com/tacman/no-agenda",
    "scripts": {
        "dokku": {
            "predeploy": "php bin/console importmap:install && php bin/console asset-map:compile && php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration",
            "postdeploy": "bin/console about"
        }
    },
    "env": {
        "WEB_CONCURRENCY": {
            "description": "The number of web processes to run.",
            "value": "2"
        },
        "APP_ENV": {
            "description": "Symfony environment.",
            "value": "prod"
        },
        "APP_DEBUG": {
            "description": "Symfony debug flag.",
            "value": "0"
        }
    },
    "image": "gliderlabs/herokuish",
    "addons": [],
    "buildpacks": [
        {
            "url": "https://github.com/heroku/heroku-buildpack-php.git"
        }
    ],
    "healthchecks": {
        "web": [
            {
                "type": "startup",
                "name": "web check",
                "description": "Symfony health endpoint",
                "path": "/health",
                "attempts": 10,
                "timeout": 5,
                "wait": 5
            }
        ]
    }
}
