{
    "name": "noagenda/website",
    "description": "The No Agenda Show website and podcast archive",
    "type": "project",
    "license": "MIT",
    "prefer-stable": true,
    "minimum-stability": "beta",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "api-platform/doctrine-orm": "^4.1",
        "api-platform/symfony": "^4.1",
        "babdev/pagerfanta-bundle": "^4.5",
        "benlipp/srt-parser": "^1.1",
        "composer/package-versions-deprecated": "1.11.99.3",
        "doctrine/annotations": "^2.0",
        "doctrine/dbal": "^4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "dragonmantank/cron-expression": "^3.3",
        "easycorp/easyadmin-bundle": "^5.3",
        "laminas/laminas-feed": "^2.10",
        "minishlink/web-push": "^11.0",
        "nelmio/cors-bundle": "^2.5",
        "pagerfanta/doctrine-orm-adapter": "^3.6|^4.7",
        "pagerfanta/twig": "^3.6|^v4.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.1",
        "sentry/sentry-symfony": "^5.2",
        "survos/imgproxy-bundle": "^2.15",
        "symfony/amqp-messenger": "^8.1",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.4",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/maker-bundle": "^1.14",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/scheduler": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/telegram-notifier": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1",
        "symfonycasts/sass-bundle": "^0.10",
        "vipnytt/opmlparser": "dev-master"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "jawira/doctrine-diagram-bundle": "dev-main",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "*",
        "survos/deployment-bundle": "^2.15",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "assets:build": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "diagram": "mkdir -p assets/images && bin/console doctrine:diagram --filename=assets/images/db.svg --exclude=doctrine_migration_versions,messenger_messages"

    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "docker": false,
            "require": "^8.1"
        }
    }
}
