{% extends 'admin/base.html.twig' %}
{% block page_title %}{{ episode.code }}: {{ episode.name }}{% endblock %}
{% block content %}
<div class="d-flex flex-wrap gap-2 mb-3">
<a class="btn btn-outline-primary" href="{{ path('episode_search') }}">Search episodes</a>
<a class="btn btn-primary" href="{{ path('podcast_episode', {code: episode.code}) }}">Listen</a>
<a class="btn btn-outline-primary" href="{{ path('survos_workflow', {flowCode: 'episode'}) }}">Workflow</a>
<a class="btn btn-outline-primary" href="{{ path('survos_workflow', {flowCode: 'episode_segment'}) }}">Segment workflow</a>
<span class="badge bg-blue-lt align-self-center">{{ episode.marking ?? 'new' }}</span>
</div>
{% set segments = analysis.segments|default([]) %}
{% set completed = segments|filter(segment => segment.summary is not empty) %}
<div class="alert alert-info">
    <strong>{{ completed|length }} generated summaries ready to review.</strong>
    {{ pendingTasks }} tasks remain. Pending tasks run through the episode workflow.
</div>
{% if episode.denseSummary %}
<div class="card mb-3"><div class="card-body">
<h2 class="card-title">Whole-episode AI summary</h2>
<div>{{ episode.denseSummary|markdown_to_html }}</div><small class="text-secondary">AI-generated from the transcript segment summaries.</small>
</div></div>
{% else %}
<p class="text-secondary">The whole-episode summary has not been generated. These samples cover only the time ranges shown.</p>
{% endif %}
<section data-controller="summary-panels" aria-label="AI segment summaries">
<div class="d-flex justify-content-between align-items-center mb-3">
<h2 class="h3 mb-0">Segment summaries</h2>
<div class="btn-group"><button type="button" class="btn btn-sm btn-outline-primary" data-action="summary-panels#openAll">Open all summaries</button><button type="button" class="btn btn-sm btn-outline-secondary" data-action="summary-panels#closeAll">Close all summaries</button></div>
</div>
{% for index, segment in completed %}
{% set run = segmentRuns[index]|default(null) %}
<details class="card mb-3 p-3" data-summary-panels-target="panel" open>
<summary class="fw-semibold">{{ segment.start|prettyTimestamp }}–{{ segment.end|prettyTimestamp }} · {{ segment.chapter_title|default('AI summary', true) }}</summary>
<div class="pt-3">
<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
<h2 class="card-title mb-0">AI summary · {{ segment.start|prettyTimestamp }}–{{ segment.end|prettyTimestamp }}</h2>
<a href="{{ path('podcast_episode', {code: episode.code, t: segment.start|prettyTimestamp}) }}">Listen to this segment</a>
</div>
{% if run %}<div class="text-secondary small mb-3">{{ run.model }} · {% if run.durationMs is not null %}{{ (run.durationMs / 1000)|number_format(2) }} seconds{% else %}provider batch{% endif %} · {{ run.inputTokens|number_format }} input / {{ run.outputTokens|number_format }} output tokens</div>{% endif %}
<div class="ai-summary">{{ segment.summary|markdown_to_html }}</div>
<details class="mt-3" data-transcript-panel><summary>Show source transcript</summary>
<ol class="list-unstyled mt-3 mb-0">
{% for line in transcripts[index]|default([]) %}
<li class="d-flex gap-3 py-2 border-bottom"><a class="text-nowrap font-monospace" href="{{ path('podcast_episode', {code: episode.code, t: line.startTime|prettyTimestamp}) }}">{{ line.startTime|prettyTimestamp }}</a><span>{{ line.text }}</span></li>
{% endfor %}
</ol></details>
</div></details>
{% else %}<p>No generated samples yet.</p>{% endfor %}
</section>
<div class="card mb-3"><div class="card-body"><h2 class="card-title">Chapters</h2>
{% for chapter in chapters %}<div class="mb-3"><a href="{{ path('podcast_episode', {code: episode.code, t: chapter.startTime|prettyTimestamp}) }}">{{ chapter.startTime|prettyTimestamp }} — {{ chapter.title }}</a></div>
{% else %}<p class="text-secondary">No chapter markers available.</p>{% endfor %}
</div></div>
<div class="card mb-3"><div class="card-body"><h2 class="card-title">AI runs</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Task</th><th>Model</th><th>Seconds</th><th>Input tokens</th><th>Output tokens</th></tr></thead><tbody>
{% for run in runs %}<tr><td>{{ run.source }}</td><td>{{ run.model ?? '—' }}</td><td>{{ run.durationMs is not null ? (run.durationMs / 1000)|number_format(2) : '—' }}</td><td>{{ run.inputTokens ?? '—' }}</td><td>{{ run.outputTokens ?? '—' }}</td></tr>
{% else %}<tr><td colspan="5">No AI runs yet.</td></tr>{% endfor %}
</tbody></table></div></div></div>
<p class="text-secondary">Tags and episode question answering are not enabled yet.</p>
{% endblock %}
